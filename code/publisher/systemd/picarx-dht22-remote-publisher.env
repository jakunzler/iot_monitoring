# Copiar para /etc/default/picarx-dht22-remote-publisher (serviço picarx-dht22-remote-publisher).
# systemd exporta estas variáveis para o processo Python (formato KEY=valor, sem espaços em torno do =).

PUBLISH_URL=http://200.137.220.50:8080/api/ingest
DEVICE_ID=PiCarX-RM520N-DHT22
READ_INTERVAL_S=2.5
REQUEST_TIMEOUT_S=10
DHT_GPIO_BCM=14
