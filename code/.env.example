# Configurações para Deploy GCP Cloud Run
# Copie este arquivo para .env e ajuste os valores

# Configurações do Projeto GCP
PROJECT_ID=your-project-id
REGION=us-central1

# Nomes dos Serviços
BACKEND_SERVICE=dht22-backend
FRONTEND_SERVICE=dht22-frontend

# URLs dos Serviços (serão preenchidas automaticamente após deploy)
BACKEND_URL=https://dht22-backend-HASH-uc.a.run.app
FRONTEND_URL=https://dht22-frontend-HASH-uc.a.run.app

# Configurações do Backend
FLASK_ENV=production
DATABASE_FILE=/tmp/dht22_data.db
PORT=8080

# Configurações do Frontend
REACT_APP_API_URL=https://dht22-backend-HASH-uc.a.run.app

# Configurações de Recursos
BACKEND_MEMORY=512Mi
BACKEND_CPU=1
FRONTEND_MEMORY=512Mi
FRONTEND_CPU=1

# Escalabilidade
MIN_INSTANCES=1
MAX_INSTANCES=10
