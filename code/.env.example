# Configurações para Deploy GCP Cloud Run
# Copie este arquivo para .env e ajuste os valores

# Configurações do Projeto GCP
PROJECT_ID=your-project-id
REGION=us-central1

# Nomes dos Serviços
BACKEND_SERVICE=dht22-backend
FRONTEND_SERVICE=dht22-frontend

# URLs dos Serviços (serão preenchidas automaticamente após deploy)
FRONTEND_URL=https://dht22-frontend-HASH-uc.a.run.app

# Frontend: mesmo domínio Cloud Run + proxy nginx → VM (ver docs/deployment/GCP_CLOUD_BUILD_FRONTEND.md secção 7).
VITE_API_URL=__SAME_ORIGIN__
BACKEND_PROXY_URL=http://YOUR_VM_IP:8080

# Opcional: backend com TLS válido num hostname (não https://IP).
# BACKEND_URL=https://dht22-backend-HASH-uc.a.run.app
# VITE_API_URL pode ser essa URL em vez de __SAME_ORIGIN__.

# Configurações do Backend
FLASK_ENV=production
DATABASE_FILE=/tmp/dht22_data.db
PORT=8080

REACT_APP_API_URL=https://dht22-backend-HASH-uc.a.run.app

# Configurações de Recursos
BACKEND_MEMORY=512Mi
BACKEND_CPU=1
FRONTEND_MEMORY=512Mi
FRONTEND_CPU=1

# Escalabilidade
MIN_INSTANCES=1
MAX_INSTANCES=10
