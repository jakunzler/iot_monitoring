# Configuração do Google Cloud Run
# Substitua os valores abaixo pelos seus dados

# ID do projeto Google Cloud
PROJECT_ID="steel-climber-466411-d1"

# Nome do serviço no Cloud Run
SERVICE_NAME="dht22-server"

# Região onde o serviço será deployado
REGION="us-central1"

# Configurações do serviço
MEMORY="512Mi"
CPU="1"
MAX_INSTANCES="10"
MIN_INSTANCES="0"
TIMEOUT="300"
CONCURRENCY="1000"

# Variáveis de ambiente
PORT="8080"
FLASK_ENV="production"
DATABASE_FILE="dht22_data.db"
MAX_RECORDS="1000"

# URLs (serão preenchidas automaticamente após o deploy)
SERVICE_URL=""
HEALTH_URL=""
API_URL=""
