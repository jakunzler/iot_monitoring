# Dockerfile para servidor DHT22 no Google Cloud Run
FROM python:3.12-slim

# Definir variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV FLASK_ENV=production

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Criar diretório de trabalho
WORKDIR /app

# Copiar arquivos de dependências
COPY backend/requirements.txt .

# Instalar dependências Python
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código da aplicação
COPY server_cloudrun.py ./server.py
COPY backend/monitor_server.py .

# Criar diretório para logs
RUN mkdir -p /var/log/dht22-server

# Criar usuário não-root para segurança
RUN groupadd -r dht22 && useradd -r -g dht22 dht22
RUN chown -R dht22:dht22 /app /var/log/dht22-server

# Mudar para usuário não-root
USER dht22

# Expor porta (Cloud Run usa a variável PORT)
EXPOSE $PORT

# Comando de inicialização
CMD ["python", "server.py"]
